# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/geospread

# Server Configuration
PORT=5000

# Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Config (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Gmail + App Password) สำหรับส่งรหัสยืนยันอีเมล
# สร้าง App Password ที่ https://myaccount.google.com/apppasswords (ต้องเปิด 2-Step Verification ก่อน)
# ถ้าเว้นว่างไว้ ตอนพัฒนาจะแสดงรหัสใน console ของ backend แทนการส่งจริง
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
MAIL_FROM_NAME=GeoSpread
